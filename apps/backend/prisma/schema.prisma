// Prisma schema for Stellaro backend
// Location: apps/backend/prisma/schema.prisma

// Datasource uses DATABASE_URL from environment
// Production: PostgreSQL 15+
// Development: SQLite for simplicity
datasource db {
  provider = "postgresql"
}

// Generator for Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Enums
enum WebhookSource {
  celcoin
  dock
  sumsub
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Models
model User {
  id         String    @id @default(uuid())
  email      String    @unique
  name       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  passkeys   Passkey[]
  wallets    Wallet[]
  kycProfiles KycProfile[]
  auditLogs   AuditLog[]
}

model Passkey {
  id            String   @id @default(uuid())
  userId        String
  credentialId  String   @unique
  publicKey     Bytes
  signCount     Int      @default(0)
  transports    String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String
  address    String   @unique
  provider   String   // freighter | albedo | ledger | other
  network    String   // testnet | mainnet
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model WebhookEvent {
  id          String         @id @default(uuid())
  source      WebhookSource
  eventId     String         @unique
  signature   String?
  payload     Json
  receivedAt  DateTime       @default(now())
  processedAt DateTime?
  status      WebhookStatus  @default(RECEIVED)

  @@index([source, eventId])
}

// =========================
// RiskAgent Off-chain Store
// =========================

model RiskEvent {
  id        String        @id @default(uuid())
  userId    String
  type      String
  payload   Json
  createdAt DateTime      @default(now())

  @@index([userId, type, createdAt])
}

model RiskProposal {
  id          String   @id @default(uuid())
  userId      String
  proposalId  String   @unique
  confidence  Float
  actions     Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model RiskExecution {
  id          String   @id @default(uuid())
  userId      String
  proposalId  String?
  action      String
  params      Json
  executed    Boolean  @default(false)
  // Auditoria on-chain
  txHash      String?
  contractId  String?
  method      String?
  network     String? // testnet | mainnet
  dryRun      Boolean? @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// =========================
// Dados & Persistência (7)
// =========================

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycProvider {
  SUMSUB
  MANUAL
  OTHER
}

enum AuditChannel {
  OFFCHAIN
  ONCHAIN
  BOTH
}

enum AuditLevel {
  INFO
  WARN
  ERROR
  SECURITY
}

model KycProfile {
  id           String      @id @default(uuid())
  userId       String
  provider     KycProvider @default(SUMSUB)
  status       KycStatus   @default(PENDING)
  referenceId  String?     // ID no provedor externo
  data         Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}

model AuditLog {
  id           String       @id @default(uuid())
  userId       String?
  channel      AuditChannel @default(OFFCHAIN)
  level        AuditLevel   @default(INFO)
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  // Referências on-chain quando aplicável
  network      String?
  contractId   String?
  method       String?
  txHash       String?
  createdAt    DateTime     @default(now())
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([channel, level, createdAt])
}

// Ingestão de eventos do ledger (Soroban/Horizon) para consultas rápidas e auditoria
model OnchainEvent {
  id           String   @id @default(uuid())
  network      String   // testnet | mainnet
  contractId   String
  topic0       String?  // flatten de tópicos p/ filtros
  topic1       String?
  topic2       String?
  topic3       String?
  payload      Json
  txHash       String
  ledgerSeq    Int
  ts           DateTime  // timestamp do ledger

  @@index([network, contractId, ledgerSeq])
  @@index([txHash])
}

// Espelho genérico de estados/contagens para dashboards e queries <200ms
model LedgerMirror {
  id           String   @id @default(uuid())
  scope        String   // ex: "stablecoin:<contractId>"
  key          String   // ex: "totalSupply", "paused", "mint_enabled"
  value        Json
  updatedAt    DateTime @default(now())

  @@unique([scope, key])
  @@index([scope])
}

// Pré-agregações/snapshots para dashboards em tempo real (consumidos via Redis também)
model DashboardSnapshot {
  id           String   @id @default(uuid())
  key          String   // ex: "tvl", "volume24h", "mint_burn_ratio"
  windowStart  DateTime
  windowEnd    DateTime
  value        Json
  createdAt    DateTime @default(now())

  @@index([key, windowStart, windowEnd])
}

// PIX Payments - Depósitos BRL para mint STLT
model PixPayment {
  id              String    @id @default(uuid())
  userId          String
  txId            String    @unique // ID da transação PIX
  amount          String    // Valor em BRL (1:1 com STLT)
  cpf             String
  name            String
  stellarAddress  String
  qrCode          String?
  pixKey          String?
  status          String    // pending, confirmed, failed
  mintTxHash      String?   // Hash da transação de mint no Stellar
  expiresAt       DateTime?
  paidAt          DateTime?
  mintedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// PIX Withdrawals - Saques BRL após burn STLT
model PixWithdrawal {
  id              String    @id @default(uuid())
  userId          String
  transferId      String    @unique // ID da transferência PIX
  amount          String    // Valor em BRL
  pixKey          String
  pixKeyType      String    // cpf, email, phone, random
  stellarAddress  String
  burnTxHash      String    // Hash da transação de burn no Stellar
  status          String    // processing, completed, failed
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Configurações de Webhook dinâmicas (Off-chain)
model WebhookSubscription {
  id        String   @id @default(uuid())
  url       String   @unique
  events    String[] // Tipos de eventos assinados
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// V4 domain entities
// =========================

model RwaAsset {
  id                String   @id @default(uuid())
  publicId          String   @unique
  name              String
  assetClass        String
  status            String
  whitelistRequired Boolean  @default(true)
  annualYieldBps    Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, assetClass])
  @@index([createdAt])
}

model SsiCredential {
  id         String   @id @default(uuid())
  publicId   String   @unique
  type       String
  issuer     String
  status     String
  disclosure String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, type])
  @@index([createdAt])
}

model SubscriptionPlan {
  id        String   @id @default(uuid())
  publicId  String   @unique
  name      String
  cadence   String
  amount    String
  currency  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, cadence])
  @@index([createdAt])
}

model DaoProposal {
  id            String   @id @default(uuid())
  publicId      String   @unique
  title         String
  status        String
  quorumBps     Int
  timelockHours Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
