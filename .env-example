# Ambiente de exemplo - copie para .env-dev / .env-homolog / .env-prod e ajuste valores

# App
NODE_ENV=development
PORT=3001
CORS_ORIGINS=https://app.stellaro.com.br,https://staging.stellaro.com.br,https://dev.stellaro.com.br,http://localhost:3000
JWT_SECRET=changeme
SESSION_TTL=3600

# Frontend (Next.js)
# URL pública da API consumida pelo frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL pública do WebSocket consumido pelo frontend (se aplicável)
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# Banco de Dados
DATABASE_URL=postgresql://stellaro:stellaro@localhost:5432/stellaro?schema=public
REDIS_URL=redis://localhost:6379

# Stellar / Soroban
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Pix - Celcoin (Sandbox)
CELCOIN_CLIENT_ID=your_celcoin_client_id
CELCOIN_CLIENT_SECRET=your_celcoin_client_secret
CELCOIN_BASE_URL=https://sandbox.openfinance.celcoin.com.br

# Cartões - Dock (Sandbox)
DOCK_API_KEY=your_dock_api_key
DOCK_BASE_URL=https://sandbox-api.dock.com
DOCK_WEBHOOK_SECRET=your_dock_webhook_secret

# KYC - Sumsub (Sandbox)
SUMSUB_APP_TOKEN=your_sumsub_app_token
SUMSUB_SECRET_KEY=your_sumsub_secret_key
SUMSUB_BASE_URL=https://api.sumsub.com

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Segurança
WEBHOOK_HMAC_SECRET=change_this_webhook_secret
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Stablecoins
STABLECOIN_DECIMALS_ONCHAIN=7
TRANSFER_FEE_BPS=10 # 0.1% = 10 basis points
