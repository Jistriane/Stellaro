# Production environment (Mainnet)
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://app.stellaro.com.br
JWT_SECRET=REPLACE_WITH_SECURE_PRODUCTION_JWT_SECRET
SESSION_TTL=3600

# Production Database (Managed Instance recommended)
DATABASE_URL=postgresql://user:password@production-db-host:5432/stellaro?schema=public
REDIS_URL=redis://production-redis-host:6379

# Stellar Mainnet Configuration
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://rpc.ankr.com/stellar_soroban
HORIZON_URL=https://horizon.stellar.org
STELLAR_HORIZON=https://horizon.stellar.org
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# Banking as a Service (Celcoin Production)
CELCOIN_CLIENT_ID=REPLACE_WITH_PRODUCTION_CLIENT_ID
CELCOIN_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_CLIENT_SECRET
CELCOIN_BASE_URL=https://openfinance.celcoin.com.br

# Card Issuing (Dock Production)
DOCK_API_KEY=REPLACE_WITH_PRODUCTION_DOCK_API_KEY
DOCK_BASE_URL=https://api.dock.com
DOCK_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_WEBHOOK_SECRET

# Decentralized Identity (Sumsub Production)
SUMSUB_APP_TOKEN=REPLACE_WITH_PRODUCTION_SUMSUB_APP_TOKEN
SUMSUB_SECRET_KEY=REPLACE_WITH_PRODUCTION_SUMSUB_SECRET_KEY
SUMSUB_BASE_URL=https://api.sumsub.com

# Monitoring & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.production-monitoring.com
SENTRY_DSN=REPLACE_WITH_PRODUCTION_SENTRY_DSN

# Security
WEBHOOK_HMAC_SECRET=REPLACE_WITH_SECURE_HMAC_SECRET
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

