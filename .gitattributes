# Track large binaries and build artifacts via Git LFS
*.wasm filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
*.rlib filter=lfs diff=lfs merge=lfs -text
contracts/target/** filter=lfs diff=lfs merge=lfs -text

# Optional: large logs or zkey/ptau files
circuits/*.zkey filter=lfs diff=lfs merge=lfs -text
circuits/*.ptau filter=lfs diff=lfs merge=lfs -text
